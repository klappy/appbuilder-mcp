{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "appbuilder-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Observability — free, on by default. Surfaces logs in the CF dashboard.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Bundle alias — agents@0.2.x dynamically imports the `ai` SDK for a code path
  // we never use. esbuild still resolves it at bundle time. Aliasing to an empty
  // stub avoids shipping the AI SDK (multi-MB) and avoids peerDep semver wrangling.
  // See src/stubs/ai-empty.ts for context. Inherited verbatim from ptxprint-mcp.
  "alias": {
    "ai": "./src/stubs/ai-empty.ts"
  },

  // Three Durable Object classes:
  //   AppbuilderMcp      — the McpAgent itself (agents/mcp wraps stateful sessions in a DO)
  //   JobStateDO         — per-job state machine (state, progress, urls, errors)
  //   AppbuilderContainer — the Container DO wrapper (CF Containers run inside DOs)
  "durable_objects": {
    "bindings": [
      { "name": "MCP_AGENT", "class_name": "AppbuilderMcp" },
      { "name": "JOB_STATE", "class_name": "JobStateDO" },
      { "name": "APPBUILDER_CONTAINER", "class_name": "AppbuilderContainer" }
    ]
  },

  // SQLite-backed DO migrations — single migration declares all three classes.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AppbuilderMcp", "JobStateDO", "AppbuilderContainer"]
    }
  ],

  "r2_buckets": [
    {
      "binding": "OUTPUTS",
      "bucket_name": "appbuilder-outputs"
      // Lifecycle policy: configure 90-day retention in the CF dashboard or via
      // `wrangler r2 bucket lifecycle add` after first deploy.
    }
  ],

  // Container declaration — the image is built from ./Dockerfile during `wrangler deploy`.
  // standard-3 = 1/2 vCPU, 12 GiB memory, 20 GB disk — chosen because the SAB
  // Android toolchain (JDK + Android SDK + Gradle cache) is materially larger
  // than PTXprint's TeX install. v0.1 sets max_instances=2 for cost control;
  // bump in v0.x as load demands. ptxprint-mcp uses standard-2 (1 vCPU, 6 GiB,
  // 12 GB) — appbuilder-mcp will revisit sizing after first end-to-end build.
  //
  // Authority: canon/specs/appbuilder-mcp-v1-spec.md §5.
  "containers": [
    {
      "class_name": "AppbuilderContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "standard-3"
    }
  ],

  // Analytics Engine dataset for telemetry (mirrors ptxprint-mcp's v1.3 pattern).
  // Authority: canon/specs/appbuilder-mcp-v1-spec.md §6.
  "analytics_engine_datasets": [
    { "binding": "APPBUILDER_TELEMETRY", "dataset": "appbuilder_telemetry" }
  ],

  "vars": {
    // Canonical public URL of this Worker. Used by submit_build to compute
    // the `worker_callback_url` it sends to the Container. Same gotcha as
    // ptxprint-mcp: if unset, container state updates silently no-op.
    "WORKER_URL": "https://appbuilder-mcp.klappy.workers.dev",
    "BUILD_TIMEOUT_DEFAULT": "1800",
    "RESULT_PRESIGNED_TTL": "604800",
    "TELEMETRY_QUERY_RATE_LIMIT_PER_HOUR": "60"
  }

  // Secrets (set via `wrangler secret put` — NOT committed to source):
  //   CF_ACCOUNT_ID               — Cloudflare account ID (used by telemetry_public)
  //   CF_API_TOKEN                — read-only AE query token (used by telemetry_public)
  //   TELEMETRY_VERIFIED_CLIENTS  — optional comma-separated consumer label allowlist
}
